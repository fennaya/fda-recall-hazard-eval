# openFDA (higher rate limits; optional for the bulk download path)
OPENFDA_API_KEY=

# Pick ONE provider and set its key. The harness auto-detects whichever is set,
# in this order: groq, openrouter, baseten, anthropic.
# Override the choice with LLM_PROVIDER, and the model with LLM_MODEL.
GROQ_API_KEY=
OPENROUTER_API_KEY=
BASETEN_API_KEY=
ANTHROPIC_API_KEY=

